# Скопіюйте цей файл як .env і впишіть свої значення.
# Зазвичай це робить розробник під час налаштування сервера.
# .env не публікується (він у .gitignore): токен = пароль від бота.

# Токен від @BotFather
TELEGRAM_TOKEN=

# Ваш chat id: бот відповідає тільки цьому акаунту (дізнатися: @userinfobot)
OWNER_CHAT_ID=

# Як часто перевіряти сайт, хвилин (не менше 3, щоб сайт не блокував)
CHECK_INTERVAL_MINUTES=5

# Де зберігати базу (пошуки і вже бачені оголошення)
DB_PATH=bot.db
